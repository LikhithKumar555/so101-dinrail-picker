<?xml version="1.0"?>
<!-- Semantic description for MoveIt: planning groups, named poses, and which link pairs never
     need collision checking (generated with scripts/generate_acm.py, then kept here). -->
<robot name="so101">
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp_link"/>
  </group>
  <group name="gripper">
    <joint name="gripper"/>
  </group>

  <group_state name="park" group="arm">
    <joint name="shoulder_pan" value="0.0"/>
    <joint name="shoulder_lift" value="-1.745"/>
    <joint name="elbow_flex" value="-1.658"/>
    <joint name="wrist_flex" value="0.262"/>
    <joint name="wrist_roll" value="0.0"/>
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="shoulder_pan" value="-0.003"/>
    <joint name="shoulder_lift" value="-0.198"/>
    <joint name="elbow_flex" value="0.810"/>
    <joint name="wrist_flex" value="0.959"/>
    <joint name="wrist_roll" value="0.046"/>
  </group_state>

  <end_effector name="gripper" parent_link="gripper_link" group="gripper" parent_group="arm"/>

  <!-- ACM: collision pairs that are skipped -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="lower_arm_link" reason="Adjacent"/>
  <disable_collisions link1="lower_arm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="moving_jaw_so101_v1_link" reason="Adjacent"/>
  <!-- generated by scripts/generate_acm.py from 1500 random states: never in collision -->
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="gripper_link" link2="lower_arm_link" reason="Never"/>
  <disable_collisions link1="lower_arm_link" link2="moving_jaw_so101_v1_link" reason="Never"/>
  <disable_collisions link1="moving_jaw_so101_v1_link" link2="wrist_link" reason="Never"/>
</robot>
