<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_safety</name>
  <version>0.1.0</version>
  <description>C++ safety monitor for SO-101 servo load, temperature and voltage.</description>
  <maintainer email="84888137+LikhithKumar555@users.noreply.github.com">Likhith Kumar Shivakumar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_manager_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rclcpp</depend>
  <depend>so101_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
