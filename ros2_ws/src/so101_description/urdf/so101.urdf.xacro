<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101">
  <xacro:arg name="use_mock_hardware" default="true"/>

  <xacro:include filename="$(find so101_description)/urdf/so101_arm.urdf"/>
  <xacro:include filename="$(find so101_description)/urdf/so101.ros2_control.xacro"/>

  <!-- Our tool centre point (TCP). It is the same frame as the "gripperframe" site in the
       MuJoCo model that our IK and pick-and-place use. The official URDF's own
       gripper_frame_link sits 2 cm further back along the gripper and is rotated
       differently - the TCP is a convention, so we define ours explicitly.
       x-axis = approach direction (out of the gripper), z-axis = jaw closing direction. -->
  <link name="tcp_link"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="tcp_link"/>
    <origin xyz="0.012 -0.000218 -0.098127" rpy="0 1.5708 0"/>
  </joint>

  <xacro:so101_ros2_control use_mock_hardware="$(arg use_mock_hardware)"/>
</robot>
